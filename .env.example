# Copy this file to .env and edit the values before starting the server.
#
# The sync user value must be username:password.
# Example only:
# SYNC_USER1=anki:change-me-to-a-long-random-password
SYNC_USER1=anki:change-me-to-a-long-random-password

# Bind to 127.0.0.1 for local-only testing.
# Use 0.0.0.0, a LAN IP, or a Tailscale IP only when you intentionally want
# other devices to connect.
SYNC_HOST=127.0.0.1
SYNC_PORT=8080
SYNC_BASE=/Users/christopherwang/Documents/Anki/data/syncserver

# Optional override if Anki is not in /Applications.
# Anki 25.09 uses "launcher"; older builds may use "anki".
ANKI_BIN=

# Project runtime paths.
ANKI_PROJECT_DIR=/Users/christopherwang/Documents/Anki
ANKI_SYNC_LOG=/Users/christopherwang/Documents/Anki/logs/anki-sync-server.log
ANKI_SYNC_PID=/Users/christopherwang/Documents/Anki/run/anki-sync-server.pid

# Private Review API prototype.
# Generate a token with: openssl rand -base64 32
ANKI_API_HOST=127.0.0.1
ANKI_API_PORT=8090
ANKI_API_TOKEN=change-me-to-a-long-random-token
ANKI_API_COLLECTION=/Users/christopherwang/Library/Application Support/Anki2/User 1/collection.anki2
ANKI_API_MEDIA=/Users/christopherwang/Library/Application Support/Anki2/User 1/collection.media
ANKI_API_WORKDIR=/Users/christopherwang/Documents/Anki/data/api
# Add your GitHub Pages URL here later, separated by commas.
ANKI_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
